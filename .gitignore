# --- Локальное окружение ---
.venv/
venv/
env/
.python-env/

# --- Секреты (в Git только .env.example без значений) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python-кэши и сборка ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Данные, модели, артефакты экспериментов (политика данных: data/README.md) ---
# В Git только описание, контракт и разрешенный учебный образец.
data/*
!data/README.md
!data/contract.json
data/raw/
data/processed/
# Отчеты валидации воспроизводятся командой из README и сохраняются как артефакт CI
reports/
models/
artifacts/
mlruns/
mlartifacts/
*.pkl
*.joblib
*.onnx
*.parquet
*.csv
# Разрешенный учебный образец — после *.csv, иначе это правило его перекроет
!data/housing_sample.csv

# --- Ноутбуки и IDE ---
.ipynb_checkpoints/
.idea/
.vscode/
*.swp

# --- ОС ---
.DS_Store
Thumbs.db
